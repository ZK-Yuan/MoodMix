# MoodMix 环境配置文件

# ═══ LLM 配置 ═══
# 火山引擎 豆包 API Key - 用于 mood 分析
# 在 https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey 获取你的 API Key
VOLCENGINE_API_KEY=c361dd0b-231b-48e0-92c2-61061f1d042e
# 推理接入点 Endpoint ID（从火山方舟控制台获取）
VOLCENGINE_ENDPOINT=ep-20260312135819-2tl8g
VOLCENGINE_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# ═══ 服务器配置 ═══
NODE_ENV=development

# 前端应用端口
# PORT=3000  # 生产环境由 Render 平台设置

# API 代理服务器端口
PROXY_PORT=3001

# ═══ Webpack 开发服务器配置（用于 npm start） ═══
# 禁用 Host 头检查，允许本地访问（localhost, 127.0.0.1 以及其他 Host）
# 这允许你从不同的 Host 访问开发服务器
HOST=0.0.0.0

# 为了支持 Render.com 等平台的自动 Host 头验证，可以设置 DANGEROUSLY_DISABLE_HOST_CHECK
# 仅在开发环境中使用！
DANGEROUSLY_DISABLE_HOST_CHECK=true

# ═══ 可选项 ═══
# 公共 URL（如果部署在子路径上）
PUBLIC_URL=/

# 浏览器自动打开（开发用）
BROWSER=none
